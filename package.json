{
  "name": "github-release",
  "version": "4.6.0",
  "description": "A GitHub Action that creates a Github release with file upload and automatically generated release notes.",
  "author": "Yakuhzi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yakuhzi/action-release.git"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env ./dist/index.js",
    "start:dev": "npx @github/local-action . src/main.ts .env",
    "release": "./release.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "axios": "^1.21.1",
    "firebase-admin": "^14.5.1",
    "mime": "^4.1.2",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
